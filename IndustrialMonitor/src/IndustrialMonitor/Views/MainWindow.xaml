<Window x:Class="IndustrialMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Industrial Monitor" Height="600" Width="420"
        Background="#121212" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="INDUSTRIAL MONITOR" Foreground="#00FF66" 
                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Display de Temperatura -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Temperatura" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Temperatura, StringFormat={}{0:F2}}" Foreground="#00FF66" FontSize="48" FontWeight="Bold"/>
                    <TextBlock Text=" °C" Foreground="#00FF66" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom" Margin="5,0,0,8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Painel de Conexão -->
        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Status" Foreground="#AAAAAA" FontSize="12"/>
                <TextBlock Text="{Binding StatusConexaoTexto}" Foreground="White" FontWeight="Bold" Margin="0,5,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding PortasDisponiveis}" 
                              SelectedItem="{Binding PortaSelecionada}" DisplayMemberPath="NomeExibicao" Height="30"/>
                    <Button Grid.Column="1" Command="{Binding AtualizarPortasCommand}" Content="↺" Width="35" Height="30" Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Botões -->
        <UniformGrid Grid.Row="3" Columns="2" Margin="0,0,0,10">
            <Button Command="{Binding ConectarCommand}" Content="Conectar" Height="35" Margin="0,0,5,0" Background="#80D8FF"/>
            <Button Command="{Binding DesconectarCommand}" Content="Desconectar" Height="35" Margin="5,0,0,0"/>
        </UniformGrid>

        <!-- Painel de Log / Diagnóstico -->
        <GroupBox Grid.Row="4" Header="Log de Comunicação" Foreground="#AAAAAA" Margin="0,5,0,0">
            <TextBox Text="{Binding LogTexto}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                     Background="#0A0A0A" Foreground="#00FF66" FontFamily="Consolas" FontSize="11" 
                     TextWrapping="Wrap" Margin="5"/>
        </GroupBox>
    </Grid>
</Window>