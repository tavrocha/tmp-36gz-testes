<Window x:Class="IndustrialMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IndustrialMonitor.ViewModels"
        Title="Industrial Monitor" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#121212" Foreground="White">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <TextBlock Grid.Row="0" Text="INDUSTRIAL MONITOR" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Foreground="#00E676" Margin="0,0,0,20"/>

        <!-- Painel de Temperatura -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="20" Margin="0,0,0,20" BorderBrush="#333333" BorderThickness="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Temperatura" FontSize="14" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TemperaturaAtual, StringFormat={}{0:F2}}" FontSize="48" FontWeight="Bold" Foreground="#00E676"/>
                    <TextBlock Text=" °C" FontSize="28" FontWeight="SemiBold" Foreground="#00E676" VerticalAlignment="Bottom" Margin="5,0,0,8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status do Sistema -->
        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="#333333" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Status" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding StatusTexto}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding PortasDisponiveis}" SelectedItem="{Binding PortaSelecionada}" DisplayMemberPath="NomeExibicao" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="↺" Command="{Binding AtualizarPortasCommand}" Width="30"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Botões de Controle -->
        <UniformGrid Grid.Row="3" Columns="2">
            <Button Content="Conectar" Command="{Binding ConectarCommand}" Height="40" Margin="0,0,5,0" Background="#00897B" Foreground="White" FontWeight="Bold"/>
            <Button Content="Desconectar" Command="{Binding DesconectarCommand}" Height="40" Margin="5,0,0,0" Background="#D32F2F" Foreground="White" FontWeight="Bold"/>
        </UniformGrid>
    </Grid>
</Window>